# Settings for the dev tools (deploy.sh, build-ipk.py, devserver.mjs, tvdebug.mjs, shots.mjs).
# Copy to tools/local.env (git-ignored) or ~/.config/plexlite/config.env (shared by all checkouts).
# Environment variables override both files. Every setting is optional.

# How to reach the TV over SSH (rooted TV or dev mode, see README). A Host alias in ~/.ssh/config,
# or user@address. Default: lgtv
PLEXLITE_TV_SSH=root@192.168.1.50

# A file holding PLEX_TOKEN=... and PLEX_CLIENT_ID=... for dev builds (deploy.sh --dev) and the
# desktop dev server. Keep it outside the repo and outside any synced folder.
# Default: ~/.config/plexlite/plex.env
PLEX_ENV_FILE=~/.config/plexlite/plex.env

# App id to build and deploy as. Default: the id in appinfo.json. Changing it on a TV that already
# has the app installs a second, separate app with its own sign-in (see README, "App id").
# PLEXLITE_APP_ID=com.example.plexlite

# Where deploy.sh builds packages. Dev builds embed a token, so keep this out of the repo.
# Default: ~/.cache/plexlite
# PLEXLITE_BUILD=~/.cache/plexlite

# Local port of the DevTools tunnel (ssh -f -N -L 19998:127.0.0.1:9998 "$PLEXLITE_TV_SSH").
# TVDEBUG_PORT=19998

# shots.mjs picks the first movie and TV library and their most recently watched titles. Pin them
# here for repeatable screenshots (library section keys and a movie ratingKey from your server).
# PLEXLITE_SHOTS_MOVIES=1
# PLEXLITE_SHOTS_SHOWS=2
# PLEXLITE_SHOTS_MOVIE=12345
