# Plex Lite home helper settings. Installed as /etc/plexlite-helper/helper.env (mode 0600,
# owned by root): it holds API keys, so never commit it, paste it into a chat or a ticket.
# After a change: systemctl restart plexlite-helper. Docs: docs/HELPER.md.
#
# One setting per line, NO comments after a value: systemd keeps them as part of the value
# ("DRY_RUN=0 # live" is not 0, so the helper stays in dry run, and says so in its log).

# ---- Safety: start in dry run ------------------------------------------------------------------
# 1 = look everything up, log and comment the plan on the Seerr issue, change nothing.
# Leave it at 1 until the dry-run comments look right, then set 0 and restart. Only exactly
# 0, false, no or off turns it off; anything else keeps the dry run.
DRY_RUN=1
# 1 = acknowledge Seerr's webhook and only log it (a kill switch). Creating the file
# /var/lib/plexlite-helper/PAUSED does the same without a restart. Anything but 0/false/no/off
# (or empty) counts as paused.
PAUSED=0

# ---- Where it listens (LAN only: never expose it through a reverse proxy) -----------------------
PORT=8787
BIND=0.0.0.0

# ---- Seerr / Overseerr: Settings → General → API Key --------------------------------------------
SEERR_URL=http://seerr.example.com:5055
SEERR_API_KEY=
# Seerr's webhook agent sends "Authorization: Bearer <this>". install.sh fills in a random one.
WEBHOOK_SECRET=

# ---- Sonarr and Radarr: Settings → General → Security → API Key ----------------------------------
SONARR_URL=http://sonarr.example.com:8989
SONARR_API_KEY=
RADARR_URL=http://radarr.example.com:7878
RADARR_API_KEY=

# ---- Bazarr (optional, for subtitles): Settings → General → Security → API Key ------------------
BAZARR_URL=
BAZARR_API_KEY=

# ---- Plex --------------------------------------------------------------------------------------
# PLEX_URL is needed for every action (search, subtitles): the helper checks the viewer's Plex
# token against this server. Use the LAN address, e.g. http://plex.example.com:32400
PLEX_URL=
# The server owner's token. With it the helper checks a season report against Plex's own season
# before deleting anything (without it, season reports wait for a person), and asks Plex to
# refresh an item after Bazarr adds a subtitle.
PLEX_TOKEN=

# ---- Reports -----------------------------------------------------------------------------------
# "Something else" reports: manual (comment "A person will look at this", leave open) or regrab.
OTHER_ACTION=manual
# A film or single episode whose file has NO download history in Radarr/Sonarr (no import, no grab:
# e.g. files found by a rescan): redownload = delete it and search again without a blocklist (the
# same release may come back), only when the report names exactly that file; manual = leave it for
# a person. Seasons with no history always wait. Anything but these two words counts as manual.
NO_HISTORY_ACTION=redownload
# On every start, also handle open Plex Lite reports from the last N days that were never
# handled. Keep 0: run a backfill once, on purpose, with
#   echo 14 > /var/lib/plexlite-helper/BACKFILL_DAYS && systemctl restart plexlite-helper
# (the file is used once and deleted), or `node helper.mjs --env … --backfill-days 14` by hand.
BACKFILL_DAYS=0
# Webhook reports older than this are left alone (Seerr retries, restarts…).
MAX_ISSUE_AGE_MINUTES=15
# A season report never touches more files than this. A season is only deleted when Plex's
# season holds the same files as Sonarr's (needs PLEX_TOKEN); lower this to be more careful.
MAX_FILES_PER_ISSUE=25
# Automatic re-grab limits (rolling windows). Over a limit, the report waits for a person.
LIMIT_PER_USER_24H=3
LIMIT_TOTAL_24H=10
LIMIT_PER_TITLE_7D=2
# Seerr user ids that never trigger automatic fixes, comma separated.
DENY_USERS=

# ---- Plex Lite actions ---------------------------------------------------------------------------
# Searches, subtitle downloads and syncs per viewer token every 10 minutes.
ACTIONS_PER_10_MIN=20
# Refused Plex tokens per client address, and new (uncached) token checks in all, per 10 minutes.
AUTH_FAILS_PER_IP_10_MIN=10
TOKEN_CHECKS_PER_10_MIN=60
# How long a subtitle search waits for Bazarr before answering "not found".
SUBTITLE_WAIT_SECONDS=45
# A "subtitles missing" report stops starting new searches after this long (other reports wait).
SUBTITLE_RUN_MAX_SECONDS=180

# Only for running by hand (systemd gives the service its own state folder):
# STATE_DIR=/var/lib/plexlite-helper
