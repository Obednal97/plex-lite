# Plex Lite home helper settings. Installed as /etc/plexlite-helper/helper.env (mode 0600,
# owned by root): it holds API keys, so never commit it, paste it into a chat or a ticket.
# After a change: systemctl restart plexlite-helper. Docs: docs/HELPER.md.

# ---- Safety: start in dry run ------------------------------------------------------------------
# 1 = look everything up, log and comment the plan on the Seerr issue, change nothing.
# Leave it at 1 until the dry-run comments look right, then set 0 and restart.
DRY_RUN=1
# 1 = acknowledge Seerr's webhook and only log it (a kill switch). Creating the file
# /var/lib/plexlite-helper/PAUSED does the same without a restart.
PAUSED=0

# ---- Where it listens (LAN only: never expose it through a reverse proxy) -----------------------
PORT=8787
BIND=0.0.0.0

# ---- Seerr / Overseerr: Settings → General → API Key --------------------------------------------
SEERR_URL=http://seerr.example.com:5055
SEERR_API_KEY=
# Seerr's webhook agent sends "Authorization: Bearer <this>". install.sh fills in a random one.
WEBHOOK_SECRET=

# ---- Sonarr and Radarr: Settings → General → Security → API Key ----------------------------------
SONARR_URL=http://sonarr.example.com:8989
SONARR_API_KEY=
RADARR_URL=http://radarr.example.com:7878
RADARR_API_KEY=

# ---- Bazarr (optional, for subtitles): Settings → General → Security → API Key ------------------
BAZARR_URL=
BAZARR_API_KEY=

# ---- Plex --------------------------------------------------------------------------------------
# PLEX_URL is needed for every action (search, subtitles): the helper checks the viewer's Plex
# token against this server. Use the LAN address, e.g. http://plex.example.com:32400
PLEX_URL=
# Optional: the server owner's token, so the helper can ask Plex to refresh an item after
# Bazarr adds a subtitle. Without it the new subtitle shows after Plex's next scan.
PLEX_TOKEN=

# ---- Reports -----------------------------------------------------------------------------------
# "Something else" reports: manual (comment "A person will look at this", leave open) or regrab.
OTHER_ACTION=manual
# On start, open Plex Lite reports from the last N days that were never handled are processed
# once (0 = off).
BACKFILL_DAYS=14
# Webhook reports older than this are left alone (Seerr retries, restarts…).
MAX_ISSUE_AGE_MINUTES=15
# A season report never touches more files than this.
MAX_FILES_PER_ISSUE=25
# Automatic re-grab limits (rolling windows). Over a limit, the report waits for a person.
LIMIT_PER_USER_24H=3
LIMIT_TOTAL_24H=10
LIMIT_PER_TITLE_7D=2
# Seerr user ids that never trigger automatic fixes, comma separated.
DENY_USERS=

# ---- Plex Lite actions ---------------------------------------------------------------------------
# Searches, subtitle downloads and syncs per viewer token every 10 minutes.
ACTIONS_PER_10_MIN=20
# How long a subtitle search waits for Bazarr before answering "not found".
SUBTITLE_WAIT_SECONDS=45

# Only for running by hand (systemd gives the service its own state folder):
# STATE_DIR=/var/lib/plexlite-helper
